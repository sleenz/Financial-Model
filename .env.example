# API Keys for Financial Data Sources
# Copy this file to .env and fill in your API keys

# Alpha Vantage (https://www.alphavantage.co/support/#api-key)
# Free tier: 500 API calls per day
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Twelve Data (https://twelvedata.com/)
# Free tier: 800 API calls per day
TWELVE_DATA_KEY=your_twelve_data_key_here

# Financial Modeling Prep (https://financialmodelingprep.com/)
# Free tier available
FMP_KEY=your_fmp_key_here

# Optional: Yahoo Finance RSS (no key required for basic usage)
# YAHOO_RSS_ENABLED=true

# Cache Configuration
CACHE_DIR=.cache
CACHE_TTL_INTRADAY=3600
CACHE_TTL_HISTORICAL=86400

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/portfolio_optimizer.log
